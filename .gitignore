# =====================================================================
# .gitignore — CheckPoint05
# Sobe para o GitHub SOMENTE: notebook, app.py, requirements.txt,
# README.md, data/adult.csv e model/. Todo o resto é ignorado.
# =====================================================================

# ---- Uso interno / não deve subir ----
ROTEIRO_APRESENTACAO.md
*.log
NOTAS*.md
notas*.md
rascunho*
scratch*/

# ---- Enunciado / anexos do professor e PDFs de referência ----
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls

# ---- Backups e temporários ----
*.template_backup.ipynb
*.bak
*.tmp
*.orig
*~
~$*

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/
.python-version
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Caches de dados / ML ----
scikit_learn_data/
.optuna/
*.sqlite3
catboost_info/
mlruns/

# ---- Sistema operacional ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Editores / IDEs ----
.idea/
.vscode/
*.code-workspace
*.sublime-*
.spyproject/
.spyderproject/

# ---- Mídia e arquivos pesados que porventura caiam na pasta ----
*.mp4
*.mkv
*.mov
*.avi
*.m4v
*.mp3
*.wav
*.zip
*.rar
*.7z
*.torrent
*.png
*.jpg
*.jpeg
*.gif
!diagrama*.png

# ---- Segredos (nunca versionar) ----
.env
.env.*
*.key
*.pem
secrets*.json
